{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WatchCodes/CodeFoundry/main/schemas/discovery-manifest.schema.json",
  "title": "DiscoveryManifest",
  "description": "Emitted by NastechResearch/100Ways. Consumed by RepoAtlas. One per discovery batch.",
  "type": "object",
  "required": ["schema_version", "batch_id", "source", "commit_sha", "created_at", "urls", "expected_repositories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.definitions.json#/$defs/schema_version" },
    "batch_id": { "$ref": "common.definitions.json#/$defs/batch_id" },
    "source": { "$ref": "common.definitions.json#/$defs/repository_ref", "description": "The scanned repository, e.g. nastechresearch/hermes-agent." },
    "commit_sha": { "$ref": "common.definitions.json#/$defs/sha" },
    "created_at": { "type": "string", "format": "date-time" },
    "urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "kind", "path", "line", "occurrences"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["repository", "profile", "issue", "pull_request", "release", "docs", "api_fragment", "fixture", "invalid"]
          },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "occurrences": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "expected_repositories": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Repository roots the scanner expects to find; readiness cross-checks against this."
    }
  }
}
